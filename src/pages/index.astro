---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SocialLink from '../components/SocialLink.astro';
import { postsIn } from '../lib/posts.js';
import { Content as News } from '../content/news.md';
const featured = (await postsIn('research')).slice(0, 4);
---
<Base title="Robotics research">
  <section class="hero">
    <p class="eyebrow">Hi, I'm Lukáš Rustler</p>
    <div class="hero-grid">
      <h1>Robotics<br /><span>researcher.</span></h1>
      <div class="hero-intro">
        <p>Exploring how robots can perceive, interact with, and safely work alongside people.</p>
        <div class="social-links">
          <SocialLink href="mailto:lukas.rustler@fel.cvut.cz" label="Email" icon="email" className="social-link" />
          <SocialLink href="https://github.com/rustlluk" label="GitHub" icon="github" className="social-link" />
          <SocialLink href="https://scholar.google.com/citations?user=Au8deJkAAAAJ&amp;hl=en" label="Scholar" icon="scholar" className="social-link" />
          <SocialLink href="https://www.linkedin.com/in/luk%C3%A1%C5%A1-rustler-2a52091b6/" label="LinkedIn" icon="linkedin" className="social-link" />
        </div>
      </div>
    </div>
  </section>

  <section class="section about">
    <div>
      <p class="eyebrow">A little about me</p>
      <h2>Research with<br /><span>a human touch.</span></h2>
      <p>I am a researcher at the Department of Cybernetics, Czech Technical University in Prague, where I recently defended my Ph.D. thesis. My research focuses on active multimodal perception for robotic grasping and manipulation, safe human-robot interaction, and multimodal calibration.</p>
      <p>My research has been published at leading robotics conferences, including ICRA, IROS, and Humanoids, and in journals such as IEEE Robotics and Automation Letters and Science Robotics. I have also served as a reviewer for Humanoids, ICRA, and IROS, as well as robotics journals.</p>
      <div class="topics"><span>Active multimodal perception</span><span>Human-robot interaction</span><span>Multimodal calibration</span></div>
    </div>
    <img class="portrait" src="/assets/images/me.jpg" alt="Lukáš Rustler" />
  </section>

  <section class="section">
    <div class="section-heading">
      <div><p class="eyebrow">Selected work</p><h2>Research</h2></div>
      <a class="text-link" href="/research/">All publications ↗</a>
    </div>
    <div class="card-grid">{featured.map((post) => <PostCard post={post} />)}</div>
  </section>

  <section class="section news">
    <p class="eyebrow">Updates</p>
    <h2 id="latest-news-heading">Latest news</h2>
    <div class="prose news-content" role="region" aria-labelledby="latest-news-heading" tabindex="0"><News /></div>
  </section>

  <section class="section contact" id="contact">
    <p class="eyebrow">Let's talk</p>
    <h2>Get in touch<span>.</span></h2>
    <p>Have a question or an idea related to robotics? Feel free to reach out.</p>
    <a class="contact-link" href="mailto:lukas.rustler@fel.cvut.cz">lukas.rustler@fel.cvut.cz ↗</a>
    <p class="muted">Prague, Czech Republic</p>
  </section>
</Base>

<style>
  .news-content {
    max-height: 18rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 0.75rem;
    scrollbar-gutter: stable;
  }
</style>
